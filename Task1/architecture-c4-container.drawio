        <mxCell id="EXT6" value="&lt;b&gt;SQL Server 2008&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System: легаси]&lt;/font&gt;&lt;br&gt;DWH, read-only&lt;br&gt;&lt;i&gt;временно, до миграции&lt;/i&gt;&lt;br&gt;&lt;i&gt;вывод 12–18 мес.&lt;/i&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#8c8c8c;gradientColor=#a6a6a6;gradientDirection=north;fontColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
