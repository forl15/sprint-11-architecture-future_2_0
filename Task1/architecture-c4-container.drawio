        <mxCell id="PERSON" value="&lt;b&gt;Бизнес-пользователь&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;Строит отчёты и смотрит KPI&lt;br&gt;в рамках своих прав&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=none;fontSize=14;fontStyle=1;align=center;verticalAlign=bottom;spacingBottom=16;" parent="1" vertex="1">
          <mxGeometry x="700" y="30" width="220" height="200" as="geometry" />
        </mxCell>
        <mxCell id="NOTE" value="&lt;b&gt;Ограничение по данным&lt;/b&gt;&lt;br&gt;Медкарты, истории болезни, снимки и результаты исследований не поступают в аналитический контур. В Lakehouse — только разрешённые операционные данные и агрегаты.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Приём проверяет allow-list типов данных и контракты.&lt;/font&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="980" y="95" width="530" height="150" as="geometry" />
        </mxCell>
        <mxCell id="BOUNDARY" value="Платформа данных «Будущее 2.0»  [Software System]" style="rounded=0;dashed=1;fillColor=none;strokeColor=#9e9e9e;strokeWidth=1.5;verticalAlign=top;align=right;spacingRight=14;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#555555;html=0;" parent="1" vertex="1">
          <mxGeometry x="80" y="280" width="1440" height="610" as="geometry" />
        </mxCell>
        <mxCell id="PORT" value="&lt;b&gt;Портал самообслуживания&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: React / TypeScript]&lt;/font&gt;&lt;br&gt;Каталог, конструктор отчётов,&lt;br&gt;запрос доступа, подписки" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;gradientColor=#5aa0e0;gradientDirection=north;fontColor=#ffffff;strokeColor=#3c7fc0;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="90" y="330" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="SEM" value="&lt;b&gt;Семантический слой и BI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Cube]&lt;/font&gt;&lt;br&gt;Модели метрик, аналитический API,&lt;br&gt;кеш, embedded Power BI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;gradientColor=#5aa0e0;gradientDirection=north;fontColor=#ffffff;strokeColor=#3c7fc0;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="470" y="330" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="GOV" value="&lt;b&gt;Каталог и метаданные&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: OpenMetadata]&lt;/font&gt;&lt;br&gt;Владельцы, lineage, глоссарий,&lt;br&gt;классификация, качество" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;gradientColor=#5aa0e0;gradientDirection=north;fontColor=#ffffff;strokeColor=#3c7fc0;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="830" y="330" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="IAM" value="&lt;b&gt;Доступ и политики&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Keycloak, OPA]&lt;/font&gt;&lt;br&gt;Keycloak — SSO/MFA,&lt;br&gt;OPA — ABAC/PDP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;gradientColor=#5aa0e0;gradientDirection=north;fontColor=#ffffff;strokeColor=#3c7fc0;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1230" y="330" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="PROC" value="&lt;b&gt;Обработка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Airflow + dbt]&lt;/font&gt;&lt;br&gt;ELT, тесты качества,&lt;br&gt;расписания" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;gradientColor=#5aa0e0;gradientDirection=north;fontColor=#ffffff;strokeColor=#3c7fc0;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="90" y="520" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="LAKE" value="&lt;b&gt;Lakehouse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: S3 + Apache Iceberg]&lt;/font&gt;&lt;br&gt;Raw → Curated → Gold&lt;br&gt;чтение через Trino" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#438dd5;gradientColor=#5aa0e0;gradientDirection=north;fontColor=#ffffff;strokeColor=#3c7fc0;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="470" y="500" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="OPS" value="&lt;b&gt;Эксплуатация и аудит&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Prometheus, Grafana, Loki, SIEM]&lt;/font&gt;&lt;br&gt;Метрики и логи запросов · SLA и алерты&lt;br&gt;Качество данных · аудит операций · backup/DR&lt;br&gt;&lt;i&gt;SLA 99,95% · RTO 1 ч · RPO 15 мин&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438dd5;gradientColor=#5aa0e0;gradientDirection=north;fontColor=#ffffff;strokeColor=#3c7fc0;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="830" y="500" width="680" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ING" value="&lt;b&gt;Приём данных&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;[Container: Kafka, Debezium, API Gateway]&lt;/font&gt;&lt;br&gt;CDC, события, API · проверка контрактов и allow-list типов данных" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#438dd5;gradientColor=#5aa0e0;gradientDirection=north;fontColor=#ffffff;strokeColor=#3c7fc0;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="110" y="730" width="1380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="EXT1" value="&lt;b&gt;Клиническая ИС&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;ЭМК, запись, услуги&lt;br&gt;&lt;i&gt;медкарты — только внутри&lt;/i&gt;&lt;br&gt;&lt;i&gt;в витрину — агрегаты&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#8c8c8c;gradientColor=#a6a6a6;gradientDirection=north;fontColor=#ffffff;strokeColor=#6b6b6b;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="95" y="980" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="EXT2" value="&lt;b&gt;ИИ-сервисы&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Изолированный контур, MLflow&lt;br&gt;&lt;i&gt;публикует: метрики моделей&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#8c8c8c;gradientColor=#a6a6a6;gradientDirection=north;fontColor=#ffffff;strokeColor=#6b6b6b;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="339" y="980" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="EXT3" value="&lt;b&gt;Финтех-системы&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Платежи, кредиты, PCI DSS&lt;br&gt;&lt;i&gt;публикует: агрегаты портфеля&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#8c8c8c;gradientColor=#a6a6a6;gradientDirection=north;fontColor=#ffffff;strokeColor=#6b6b6b;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="583" y="980" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="EXT4" value="&lt;b&gt;Корпоративные системы&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;ERP, HR, финансы&lt;br&gt;&lt;i&gt;публикует: KPI-марты&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#8c8c8c;gradientColor=#a6a6a6;gradientDirection=north;fontColor=#ffffff;strokeColor=#6b6b6b;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="827" y="980" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="EXT5" value="&lt;b&gt;Партнёры&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Фарма и медтехника&lt;br&gt;&lt;i&gt;публикует: справочники, события&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#8c8c8c;gradientColor=#a6a6a6;gradientDirection=north;fontColor=#ffffff;strokeColor=#6b6b6b;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1071" y="980" width="230" height="130" as="geometry" />
