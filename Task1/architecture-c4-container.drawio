        <mxCell id="SCEN_TITLE" value="Как архитектура поддерживает бизнес-сценарии" style="text;html=0;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1a1a2e;" parent="1" vertex="1">
          <mxGeometry x="70" y="1168" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="S1" value="&lt;b&gt;1 · Быстрая отчётность&lt;/b&gt;&lt;br&gt;Портал → Cube → Trino → Gold, кеш метрик · минуты вместо часов" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#b9d0ea;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=11;fontColor=#1f3550;" parent="1" vertex="1">
          <mxGeometry x="70" y="1206" width="730" height="64" as="geometry" />
        </mxCell>
        <mxCell id="S2" value="&lt;b&gt;2 · Самообслуживание&lt;/b&gt;&lt;br&gt;Каталог, конструктор отчётов, запрос доступа по purpose · без участия ИТ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#b9d0ea;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=11;fontColor=#1f3550;" parent="1" vertex="1">
          <mxGeometry x="810" y="1206" width="730" height="64" as="geometry" />
        </mxCell>
        <mxCell id="S3" value="&lt;b&gt;3 · Независимый финтех&lt;/b&gt;&lt;br&gt;Свой контур, свои пайплайны и data products · домены не блокируют друг друга" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#b9d0ea;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=11;fontColor=#1f3550;" parent="1" vertex="1">
          <mxGeometry x="70" y="1282" width="730" height="64" as="geometry" />
        </mxCell>
        <mxCell id="S4" value="&lt;b&gt;4 · ИИ-диагностика&lt;/b&gt;&lt;br&gt;Деперсонализация в домене, в витрину — метрики моделей · без утечки медданных" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#b9d0ea;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=11;fontColor=#1f3550;" parent="1" vertex="1">
          <mxGeometry x="810" y="1282" width="730" height="64" as="geometry" />
        </mxCell>
        <mxCell id="S5" value="&lt;b&gt;5 · Новый домен / партнёр&lt;/b&gt;&lt;br&gt;Landing zone + шаблон data product + контракт · 4–6 недель вместо месяцев" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#b9d0ea;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=11;fontColor=#1f3550;" parent="1" vertex="1">
          <mxGeometry x="70" y="1358" width="730" height="64" as="geometry" />
        </mxCell>
        <mxCell id="S6" value="&lt;b&gt;6 · Единые KPI&lt;/b&gt;&lt;br&gt;Доменные продукты → KPI-марты HQ → семантика · одна цифра для всех" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#b9d0ea;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;fontSize=11;fontColor=#1f3550;" parent="1" vertex="1">
          <mxGeometry x="810" y="1358" width="730" height="64" as="geometry" />
        </mxCell>
        <mxCell id="PRINCIPLES" value="Принципы: домены владеют данными · публикация по контракту · открытые форматы (Iceberg, Kafka, S3) · strangler-вывод легаси" style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="70" y="1436" width="1470" height="22" as="geometry" />
        </mxCell>
