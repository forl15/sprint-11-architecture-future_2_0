        <mxCell id="P1" value="&lt;b&gt;P1 · Клинический домен&lt;/b&gt;&lt;br&gt;ведёт ЭМК, записи, услуги&lt;br&gt;&lt;i&gt;медданные не покидают контур&lt;/i&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#438dd5;gradientColor=#5aa0e0;gradientDirection=north;fontColor=#ffffff;strokeColor=#3c7fc0;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
