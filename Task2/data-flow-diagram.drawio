        <mxCell id="e_p2_p1" value="результаты&#xa;инференса" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;exitX=0.7;exitY=0;entryX=0.7;entryY=1;strokeColor=#b45f06;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#8a4708;labelBackgroundColor=#ffffff;" parent="1" source="P2" target="P1" edge="1">
